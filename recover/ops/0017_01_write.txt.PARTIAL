&lt;title&gt;Paydirt &amp;amp; Picks&lt;/title&gt;
&lt;link rel="preconnect" href="https://fonts.googleapis.com"&gt;
&lt;link rel="preconnect" href="https://fonts.gstatic.com" crossorigin&gt;
&lt;link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&amp;family=IBM+Plex+Sans:wght@400;500;600&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap"&gt;
&lt;style&gt;
/* Layout: a weekly prop sheet. Masthead strip, tab bar, then one dense ranked board per market.
   Each row pairs the model's number with the market's on a single probability track. */
:root {
  --bg: #f3f4ef;          /* chalked-turf paper */
  --surface: #fbfbf8;
  --ink: #17201b;
  --muted: #5d6a61;
  --rule: #d8ddd3;
  --track: #e4e8df;
  --accent: #d9481f;      /* pylon orange */
  --model: #17201b;
  --market: #7a8a80;
  --bet: #1f7a45;  --bet-bg: #dcefe2;
  --lean: #9a6a06; --lean-bg: #f6ebcf;
  --pass: #6f7a72; --pass-bg: #eaece6;
  --warn: #a8321a; --warn-bg: #f7e1da;
  --f-display: "Barlow Condensed", "Arial Narrow", "Helvetica Neue", sans-serif;
  --f-body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --f-data: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #111613; --surface: #171d19; --ink: #e7ece6; --muted: #98a59b; --rule: #2a332d; --track: #243029;
  --accent: #f0693f; --model: #e7ece6; --market: #7f9186;
  --bet: #5fd08c; --bet-bg: #173524; --lean: #e3b24a; --lean-bg: #3a2f14; --pass: #8e9990; --pass-bg: #222a25;
  --warn: #f08a6e; --warn-bg: #3d2019; color-scheme: dark } }
:root[data-theme="dark"] {
  --bg: #111613; --surface: #171d19; --ink: #e7ece6; --muted: #98a59b; --rule: #2a332d; --track: #243029;
  --accent: #f0693f; --model: #e7ece6; --market: #7f9186;
  --bet: #5fd08c; --bet-bg: #173524; --lean: #e3b24a; --lean-bg: #3a2f14; --pass: #8e9990; --pass-bg: #222a25;
  --warn: #f08a6e; --warn-bg: #3d2019; color-scheme: dark }

body { background: var(--bg); color: var(--ink); font-family: var(--f-body); font-size: 15px; line-height: 1.45; }
.wrap { max-width: 1120px; margin: 0 auto; padding-inline: 16px; padding-block: 20px 56px; }
.num { font-family: var(--f-data); font-variant-numeric: tabular-nums; }

header.mast { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 24px;
  border-bottom: 3px solid var(--ink); padding-bottom: 12px; }
.mast h1 { font-family: var(--f-display); font-weight: 700; font-size: clamp(34px, 6vw, 52px); line-height: .95;
  letter-spacing: .01em; margin: 0; text-transform: uppercase; }
.mast h1 span { color: var(--accent); }
.mast .meta { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 13px; color: var(--muted); }
.mast .meta b { color: var(--ink); font-weight: 600; }

nav.tabs { display: flex; gap: 4px; margin-top: 18px; border-bottom: 1px solid var(--rule); overflow-x: auto; }
.tabs button { font-family: var(--f-display); font-weight: 600; font-size: 19px; letter-spacing: .04em; text-transform: uppercase;
  background: none; border: 0; color: var(--muted); padding: 8px 14px 10px; cursor: pointer; border-bottom: 3px solid transparent;
  margin-bottom: -1px; white-space: nowrap; }
.tabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--accent); }
.tabs button:focus-visible, .chip:focus-visible, input:focus-visible, select:focus-visible, .more:focus-visible, th button:focus-visible {
  outline: 2px solid var(--accent); outline-offset: 2px; }

section.panel { padding-top: 18px; display: grid; gap: 16px; }
.lede { max-width: 68ch; color: var(--muted); margin: 0; }
.lede b { color: var(--ink); font-weight: 600; }

.summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; }
.pick { background: var(--surface); border: 1px solid var(--rule); border-left: 4px solid var(--bet); padding: 10px 12px;
  display: grid; gap: 2px; min-width: 0; }
.pick.lean { border-left-color: var(--lean); }
.pick .who { font-family: var(--f-display); font-weight: 700; font-size: 21px; letter-spacing: .02em; line-height: 1.1; }
.pick .line { font-size: 13px; color: var(--muted); }
.pick .line b { color: var(--ink); }

.controls { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; }
.chip { font-family: var(--f-body); font-size: 13px; font-weight: 500; border: 1px solid var(--rule); background: var(--surface);
  color: var(--ink); padding: 5px 11px; border-radius: 999px; cursor: pointer; }
.chip[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
.controls input, .controls select { font: inherit; font-size: 14px; background: var(--surface); color: var(--ink);
  border: 1px solid var(--rule); padding: 6px 10px; border-radius: 6px; min-width: 0; }
.controls input { flex: 1 1 200px; max-width: 280px; }
.legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12px; color: var(--muted); align-items: center; }
.legend i { display: inline-block; vertical-align: middle; margin-right: 5px; }
.legend .m { width: 10px; height: 10px; border-radius: 50%; background: var(--model); }
.legend .k { width: 2px; height: 14px; background: var(--market); }

.tablebox { overflow-x: auto; background: var(--surface); border: 1px solid var(--rule); }
table { border-collapse: collapse; width: 100%; min-width: 760px; }
th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--rule); vertical-align: middle; }
th { font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted);
  background: var(--surface); position: sticky; top: 0; z-index: 1; }
th button { all: unset; cursor: pointer; }
th button[data-dir]::after { content: attr(data-dir); margin-left: 4px; color: var(--accent); }
td.r, th.r { text-align: right; }
tbody tr:last-child td { border-bottom: 0; }
tbody tr:hover { background: color-mix(in srgb, var(--track) 45%, transparent); }
.player { font-weight: 600; white-space: nowrap; }
.sub { display: block; font-size: 12px; color: var(--muted); font-weight: 400; }
.pos { font-family: var(--f-data); font-size: 11px; color: var(--muted); border: 1px solid var(--rule); padding: 0 4px; border-radius: 3px; margin-left: 4px; }

.track { position: relative; height: 18px; min-width: 150px; }
.track::before { content: ""; position: absolute; left: 0; right: 0; top: 8px; height: 3px; background: var(--track); border-radius: 2px; }
.track .fifty { position: absolute; left: 50%; top: 4px; width: 1px; height: 11px; background: var(--rule); }
.track .gap { position: absolute; top: 8px; height: 3px; border-radius: 2px; }
.track .gap.up { background: var(--accent); } .track .gap.dn { background: var(--bet); }
.track .mk { position: absolute; top: 2px; width: 2px; height: 15px; background: var(--market); margin-left: -1px; }
.track .dot { position: absolute; top: 4px; width: 11px; height: 11px; margin-left: -5.5px; border-radius: 50%; background: var(--model);
  border: 2px solid var(--surface); box-sizing: border-box; }
.track.solo .fill { position: absolute; top: 7px; left: 0; height: 5px; background: var(--accent); border-radius: 3px; }

.call { display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; padding: 2px 8px; border-radius: 3px; }
.call.bet { background: var(--bet-bg); color: var(--bet); }
.call.lean { background: var(--lean-bg); color: var(--lean); }
.call.pass { background: var(--pass-bg); color: var(--pass); }
.flag { display: inline-block; font-size: 11px; font-weight: 600; padding: 1px 6px; border-radius: 3px; background: var(--warn-bg); color: var(--warn); margin-left: 6px; }
.side { font-family: var(--f-display); font-weight: 600; font-size: 16px; letter-spacing: .04em; }
.pos-ev { color: var(--bet); } .neg-ev { color: var(--muted); }
.more { font: inherit; font-weight: 600; color: var(--ink); background: var(--surface); border: 1px solid var(--rule); padding: 8px 14px; border-radius: 6px; cursor: pointer; justify-self: start; }

.notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px 32px; }
.notes &gt; div { min-width: 0; }
.notes h2 { font-family: var(--f-display); font-weight: 700; font-size: 24px; text-transform: uppercase; letter-spacing: .03em; margin: 0 0 6px; text-wrap: balance; }
.notes p, .notes li { max-width: 65ch; margin: 0 0 8px; }
.notes ul { padding-left: 18px; margin: 0; }
.mini { width: 100%; min-width: 0; border: 1px solid var(--rule); background: var(--surface); }
.mini td, .mini th { padding: 6px 10px; font-size: 13px; }
.mini th { position: static; }
.foot { margin-top: 8px; font-size: 12px; color: var(--muted); border-top: 1px solid var(--rule); padding-top: 12px; }
@media (